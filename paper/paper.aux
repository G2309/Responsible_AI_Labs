\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Atribuciones SHAP hacia la clase predicha. Izquierda, IMG-02 (castor real). Derecha, IMG-03 (capibara en la orilla): la atribución positiva hacia \texttt  {beaver} se reparte por la orilla húmeda y el agua del borde inferior, mientras que buena parte del cuerpo del animal recibe atribución \emph  {negativa}, es decir, contribuye en contra de la etiqueta que el modelo termina eligiendo.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:shap}{{2}{3}{Atribuciones SHAP hacia la clase predicha. Izquierda, IMG-02 (castor real). Derecha, IMG-03 (capibara en la orilla): la atribución positiva hacia \texttt {beaver} se reparte por la orilla húmeda y el agua del borde inferior, mientras que buena parte del cuerpo del animal recibe atribución \emph {negativa}, es decir, contribuye en contra de la etiqueta que el modelo termina eligiendo}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces IMG-02 explicada con tres presupuestos de evaluación. La estructura gruesa se mantiene; el detalle fino cambia, por lo que no interpretamos bordes finos del mapa.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:estabilidad}{{3}{3}{IMG-02 explicada con tres presupuestos de evaluación. La estructura gruesa se mantiene; el detalle fino cambia, por lo que no interpretamos bordes finos del mapa}{figure.3}{}}
